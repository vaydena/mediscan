# MediScan – Hostinger/Apache
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType application/json .json
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  # Reihenfolge wichtig: bei mehreren Treffern gewinnt die letzte Regel.
  <FilesMatch "\.(css|js|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Grosse Referenz-DB darf laenger gecacht werden (Version steuert der Service Worker).
  <FilesMatch "mediscan-db\.json$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Service Worker, Manifest und Deploy-Marker immer frisch (schlaegt die .js-Regel oben).
  <FilesMatch "^(sw\.js|manifest\.webmanifest|deploy-version\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
